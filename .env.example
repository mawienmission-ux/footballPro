# Frontend/public app settings
VITE_APP_NAME=M.MissionFootball
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:8081

# Firebase web app config (copy from Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin access
VITE_ADMIN_EMAILS=admin@email.com

# Live football data provider (RapidAPI or equivalent)
VITE_FOOTBALL_API_KEY=your_rapidapi_key
VITE_FOOTBALL_API_HOST=api-football-v1.p.rapidapi.com
VITE_FOOTBALL_API_URL=https://api-football-v1.p.rapidapi.com/v3

# Optional server-side helper for Firestore seeding
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
GCP_PROJECT_ID=your-project-id
